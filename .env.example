# FinMate - biến môi trường
# Copy file này thành .env rồi điền giá trị. KHÔNG commit file .env.
# Đặt được ở gốc repo hoặc trong server/ — app nạp cả hai lúc khởi động.
# Sửa xong phải KHỞI ĐỘNG LẠI server, biến môi trường chỉ đọc một lần lúc chạy.

# --- Máy chủ ---
# Cổng chạy app
PORT=4000
# Địa chỉ lắng nghe. Mặc định 127.0.0.1 (chỉ máy này).
# Đặt 0.0.0.0 để dùng từ điện thoại trong cùng wifi (nhớ bật PIN trước!)
FINMATE_HOST=127.0.0.1
# Các origin được phép gọi API, cách nhau bởi dấu phẩy
# FINMATE_ORIGINS=https://finmate.example.com

# --- Dữ liệu ---
# Đường dẫn file cơ sở dữ liệu
# FINMATE_DB=C:\path\to\finmate.db
# Thư mục chứa bản sao lưu tự động.
# App ĐÃ tự sao lưu mỗi ngày một lần, không cần bật gì thêm. Nhưng mặc định
# bản sao nằm cùng ổ đĩa với bản gốc — ổ hỏng là mất cả hai. Trỏ sang thư mục
# đồng bộ đám mây để bản sao thoát khỏi máy này:
# FINMATE_BACKUP_DIR=C:\Users\ban\OneDrive\finmate-backups
# Số bản sao lưu giữ lại
FINMATE_BACKUP_KEEP=14

# --- Webhook nhận tin nhắn ngân hàng ---
# Token bắt buộc để đẩy giao dịch vào /api/ingest. Không có token thì bất kỳ ai
# trong cùng mạng WiFi cũng đẩy được giao dịch giả vào sổ của bạn.
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# FINMATE_INGEST_TOKEN=

# --- Cố vấn AI (tuỳ chọn nhưng rất nên bật) ---
# CÓ key: chat box trở thành một cố vấn tài chính thật sự — hiểu ngữ cảnh cả cuộc
#         trò chuyện, tự tra số liệu, tự ghi giao dịch/mục tiêu/quỹ vào app, và
#         dẫn dắt bạn thiết lập hồ sơ lần đầu bằng hội thoại tự nhiên.
# KHÔNG key: app vẫn chạy đủ tính năng bằng bộ hiểu tiếng Việt offline, nhưng
#         chat sẽ theo kịch bản có sẵn thay vì trò chuyện linh hoạt.
# FINMATE_LLM_KEY=sk-...
# Dùng được mọi API tương thích OpenAI (Azure OpenAI, Groq, OpenRouter, Ollama...)
# FINMATE_LLM_URL=https://api.openai.com/v1/chat/completions
# Model cần hỗ trợ function calling
# FINMATE_LLM_MODEL=gpt-4o-mini
# Đặt "off" để tắt cố vấn AI dù đã có key (quay về bộ luật offline)
# FINMATE_AGENT=off

# Dùng Claude của Anthropic: chỉ cần dán key, app tự nhận ra qua tiền tố "sk-ant-"
# và tự nói chuyện bằng Messages API — KHÔNG cần đặt FINMATE_LLM_URL.
# FINMATE_LLM_KEY=sk-ant-...
# Mặc định claude-opus-5 (cố vấn giỏi nhất). Rẻ và nhanh hơn: claude-sonnet-5,
# claude-haiku-4-5. Không thêm hậu tố ngày vào tên model.
# FINMATE_LLM_MODEL=claude-opus-5
# Ép cứng nhà cung cấp nếu tự nhận diện sai (openai | anthropic)
# FINMATE_LLM_PROVIDER=anthropic
# Độ sâu suy nghĩ của Claude: low | medium | high | xhigh | max. Bỏ trống = high.
# Chat ghi chi tiêu hằng ngày chạy "low"/"medium" nhanh và rẻ hơn hẳn mà vẫn đúng.
# FINMATE_LLM_EFFORT=medium
# Bật/tắt suy nghĩ trước khi trả lời: adaptive | off. Bỏ trống = model tự quyết.
# FINMATE_LLM_THINKING=adaptive
# Trần độ dài câu trả lời, tính cả phần suy nghĩ (mặc định 16000 với Claude)
# FINMATE_LLM_MAX_TOKENS=16000
# Chờ tối đa bao lâu cho một lượt gọi model (ms). Ollama trên máy yếu cần tăng lên.
# FINMATE_LLM_TIMEOUT_MS=90000

# Muốn số liệu tài chính KHÔNG rời khỏi máy: chạy model tại chỗ bằng Ollama
# (https://ollama.com) — miễn phí, không cần key thật.
# FINMATE_LLM_URL=http://127.0.0.1:11434/v1/chat/completions
# FINMATE_LLM_KEY=ollama
# FINMATE_LLM_MODEL=qwen2.5:14b
