# FinMate - biến môi trường
# Copy file này thành .env rồi điền giá trị. KHÔNG commit file .env.
# Đặt được ở gốc repo hoặc trong server/ — app nạp cả hai lúc khởi động.
# Sửa xong phải KHỞI ĐỘNG LẠI server, biến môi trường chỉ đọc một lần lúc chạy.

# --- Máy chủ ---
# Cổng chạy app
PORT=4000
# Địa chỉ lắng nghe. Mặc định 127.0.0.1 (chỉ máy này).
# Đặt 0.0.0.0 để dùng từ điện thoại trong cùng wifi (nhớ bật PIN trước!)
FINMATE_HOST=127.0.0.1
# Các origin được phép gọi API, cách nhau bởi dấu phẩy
# FINMATE_ORIGINS=https://finmate.example.com

# --- Dữ liệu ---
# Đường dẫn file cơ sở dữ liệu
# FINMATE_DB=C:\path\to\finmate.db
# Thư mục chứa bản sao lưu tự động.
# App ĐÃ tự sao lưu mỗi ngày một lần, không cần bật gì thêm. Nhưng mặc định
# bản sao nằm cùng ổ đĩa với bản gốc — ổ hỏng là mất cả hai. Trỏ sang thư mục
# đồng bộ đám mây để bản sao thoát khỏi máy này:
# FINMATE_BACKUP_DIR=C:\Users\ban\OneDrive\finmate-backups
# Số bản sao lưu giữ lại
FINMATE_BACKUP_KEEP=14

# --- Webhook nhận tin nhắn ngân hàng ---
# Token bắt buộc để đẩy giao dịch vào /api/ingest. Không có token thì bất kỳ ai
# trong cùng mạng WiFi cũng đẩy được giao dịch giả vào sổ của bạn.
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# FINMATE_INGEST_TOKEN=

# --- Tỷ giá ---
# Nguồn tỷ giá (mặc định open.er-api.com, miễn phí không cần key)
# FINMATE_FX_URL=https://open.er-api.com/v6/latest/EUR
# Cắt hẳn mọi lời gọi ra mạng: tỷ giá VÀ giá thị trường đều chỉ dùng số nhập tay.
# Dùng khi chạy trong mạng kín, khi test, hoặc khi bạn không muốn app tự ra ngoài.
# FINMATE_FX_OFFLINE=1

# --- Giá thị trường (cổ phiếu, vàng, crypto) ---
# Tự cập nhật mỗi giờ từ nguồn miễn phí không cần key: VNDirect/VPS (cổ phiếu VN),
# Yahoo/Stooq (quốc tế), SJC + gold-api (vàng), CoinGecko (crypto). Đặt "off" để tắt.
# FINMATE_PRICES=off
# Vàng VN khi SJC không lấy được: dùng giá thế giới cộng thêm % chênh lệch này (đặt trong app cũng được)
# (setting gold_premium_pct, mặc định 0)
# Nguồn giá vàng trong nước (mặc định XML của SJC)
# FINMATE_GOLD_URL=https://sjc.com.vn/xml/tygiavang.xml
# Bản chạy trên điện thoại bị chặn CORS với vài nguồn: đặt proxy CORS của riêng bạn, URL sẽ được nối vào sau
# FINMATE_PRICE_PROXY=https://proxy.cua-ban.com/?url=

# --- Cố vấn AI (tuỳ chọn nhưng rất nên bật) ---
# CÓ key: chat box trở thành một cố vấn tài chính thật sự — hiểu ngữ cảnh cả cuộc
#         trò chuyện, tự tra số liệu, tự ghi giao dịch/mục tiêu/quỹ vào app, và
#         dẫn dắt bạn thiết lập hồ sơ lần đầu bằng hội thoại tự nhiên.
# KHÔNG key: app vẫn chạy đủ tính năng bằng bộ hiểu tiếng Việt offline, nhưng
#         chat sẽ theo kịch bản có sẵn thay vì trò chuyện linh hoạt.
# FINMATE_LLM_KEY=sk-...
# App cũng nhận ANTHROPIC_API_KEY / OPENAI_API_KEY nếu bạn đã đặt sẵn cho công cụ
# khác — FINMATE_LLM_KEY được ưu tiên trước.
# Dùng được mọi API tương thích OpenAI (Azure OpenAI, Groq, OpenRouter, Ollama...)
# FINMATE_LLM_URL=https://api.openai.com/v1/chat/completions
# Model cần hỗ trợ function calling
# FINMATE_LLM_MODEL=gpt-4o-mini
# Đặt "off" để tắt cố vấn AI dù đã có key (quay về bộ luật offline)
# FINMATE_AGENT=off

# Dùng Claude của Anthropic: chỉ cần dán key, app tự nhận ra qua tiền tố "sk-ant-"
# và tự nói chuyện bằng Messages API — KHÔNG cần đặt FINMATE_LLM_URL.
# FINMATE_LLM_KEY=sk-ant-...
# Mặc định claude-opus-5 (cố vấn giỏi nhất). Rẻ và nhanh hơn: claude-sonnet-5,
# claude-haiku-4-5. Không thêm hậu tố ngày vào tên model.
# FINMATE_LLM_MODEL=claude-opus-5
# Ép cứng nhà cung cấp nếu tự nhận diện sai (openai | anthropic)
# FINMATE_LLM_PROVIDER=anthropic
# Độ sâu suy nghĩ của Claude: low | medium | high | xhigh | max. Bỏ trống = high.
# Chat ghi chi tiêu hằng ngày chạy "low"/"medium" nhanh và rẻ hơn hẳn mà vẫn đúng.
# FINMATE_LLM_EFFORT=medium
# Bật/tắt suy nghĩ trước khi trả lời: adaptive | off. Bỏ trống = model tự quyết.
# FINMATE_LLM_THINKING=adaptive
# Trần độ dài câu trả lời, tính cả phần suy nghĩ (mặc định 16000 với Claude)
# FINMATE_LLM_MAX_TOKENS=16000
# Chờ tối đa bao lâu cho một lượt gọi model (ms). Ollama trên máy yếu cần tăng lên.
# FINMATE_LLM_TIMEOUT_MS=90000

# Muốn số liệu tài chính KHÔNG rời khỏi máy: chạy model tại chỗ bằng Ollama
# (https://ollama.com) — miễn phí, không cần key thật.
# FINMATE_LLM_URL=http://127.0.0.1:11434/v1/chat/completions
# FINMATE_LLM_KEY=ollama
# FINMATE_LLM_MODEL=qwen2.5:14b

# ── Máy chủ thật, nhiều người dùng ──────────────────────────────────────────
# Bật thì cửa vào là TÀI KHOẢN (email + mật khẩu) thay vì mã PIN, và mỗi người
# có một file sổ SQLite riêng dưới $FINMATE_DATA_DIR/users. Chỉ bật khi chạy
# máy chủ chung; máy cá nhân và bản chạy trên điện thoại cứ để trống.
# FINMATE_MULTIUSER=1
# Thư mục dữ liệu — PHẢI trỏ vào volume khi chạy Docker, nếu không thì sổ của
# mọi người nằm trong container và mất sạch mỗi lần deploy lại.
# FINMATE_DATA_DIR=/data
# Mã mời: đặt thì phải biết mã mới đăng ký được. Máy chủ đặt trên Internet nên
# luôn đặt — không thì người lạ tạo tài khoản tới khi đầy đĩa.
# FINMATE_SIGNUP_CODE=doi-thanh-chuoi-cua-rieng-ban
# Trần số tài khoản và số lần đăng ký thành công mỗi giờ từ một địa chỉ IP.
# FINMATE_MAX_USERS=50
# FINMATE_SIGNUP_PER_HOUR=5
# Phiên đăng nhập sống bao nhiêu ngày trước khi phải đăng nhập lại.
# FINMATE_SESSION_DAYS=30
# Số sổ giữ mở cùng lúc trong bộ nhớ (sổ lâu không dùng sẽ đóng, không mất gì).
# FINMATE_MAX_OPEN_LEDGERS=200
# Chờ tối đa bao lâu cho các request đang dở khi nhận SIGTERM, trước khi đóng sổ.
# FINMATE_SHUTDOWN_MS=8000

# Quên mật khẩu qua email. Không đặt khoá thì tính năng vẫn có, chỉ là chủ máy
# chủ phát đường dẫn bằng tay:
#   npm run reset-password -w server -- --email ban@example.com
# Resend miễn phí 3.000 thư/tháng, đăng ký 5 phút, không cần thẻ.
# FINMATE_MAIL_KEY=re_...
# FINMATE_MAIL_FROM=FinMate <finmate@ten-mien-cua-ban>
# Dịch vụ khác có cùng dạng API thì đổi URL này.
# FINMATE_MAIL_URL=https://api.resend.com/emails
# Địa chỉ app nhìn từ ngoài, để dán vào đường dẫn trong thư. Không đặt thì suy
# ra từ chính request (đủ dùng khi không có proxy lạ ở giữa).
# FINMATE_PUBLIC_URL=https://finmate-cua-ban.fly.dev
# FINMATE_RESET_MINUTES=60
# FINMATE_FORGOT_PER_HOUR=8

# Đồng bộ sổ giữa bản chạy trên máy và tài khoản: trần dung lượng mỗi lần gửi.
# FINMATE_LEDGER_LIMIT=100mb

# Số tầng reverse proxy đứng trước app. KHÔNG đặt = không tin header
# X-Forwarded-For (đúng cho máy chạy tại nhà/LAN). Đặt sau Fly/Caddy/nginx thì
# khai 1 — nếu không, mọi giới hạn chống dò mật khẩu đếm theo IP của proxy.
# FINMATE_TRUST_PROXY=1
# Số lần sai mật khẩu từ một IP trước khi khoá 5 phút (theo tài khoản luôn là 8).
# FINMATE_MAX_FAILS_IP=24
