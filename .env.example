# FinMate - biến môi trường
# Copy file này thành .env rồi điền giá trị. KHÔNG commit file .env.

# --- Máy chủ ---
# Cổng chạy app
PORT=4000
# Địa chỉ lắng nghe. Mặc định 127.0.0.1 (chỉ máy này).
# Đặt 0.0.0.0 để dùng từ điện thoại trong cùng wifi (nhớ bật PIN trước!)
FINMATE_HOST=127.0.0.1
# Các origin được phép gọi API, cách nhau bởi dấu phẩy
# FINMATE_ORIGINS=https://finmate.example.com

# --- Dữ liệu ---
# Đường dẫn file cơ sở dữ liệu
# FINMATE_DB=C:\path\to\finmate.db
# Thư mục chứa bản sao lưu tự động
# FINMATE_BACKUP_DIR=C:\path\to\backups
# Số bản sao lưu giữ lại
FINMATE_BACKUP_KEEP=14

# --- Trợ lý AI (tuỳ chọn) ---
# App chạy tốt mà KHÔNG cần key: bộ hiểu ngôn ngữ tiếng Việt là offline.
# Chỉ điền nếu muốn câu trả lời tự nhiên hơn cho các câu hỏi mở.
# FINMATE_LLM_KEY=
# FINMATE_LLM_URL=https://api.openai.com/v1/chat/completions
# FINMATE_LLM_MODEL=gpt-4o-mini
